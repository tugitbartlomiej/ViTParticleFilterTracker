  "questions": [
    {
      "query": 1,
      "question": "How are Transformer residual blocks formally interpreted as numerical discretizations of interacting particle dynamical systems, including separate feed-forward drift and self-attention token interactions?"
    },
    {
      "query": 2,
      "question": "How do Transformer feed-forward networks implement key-value memories and additive vector contributions in the residual stream, and what is known about cancellation or suppression between neuron contributions?"
    },
    {
      "query": 3,
      "question": "What research tracks the representations of fixed images or fixed tokens across training checkpoints of vision transformers, distinguishing training-time trajectories from trajectories across network depth?"
    },
    {
      "query": 4,
      "question": "How do neuron value vectors in Transformer MLPs cancel or suppress one another, including prediction versus suppression neurons, negative GELU activations, superposition, and antiparallel output directions?"
    },
    {
      "query": 5,
      "question": "Which representation similarity methods correctly account for rotations, scaling, neuron permutations, or gauge symmetries when comparing neural-network representations across training checkpoints, and what are the limitations of PCA and CKA?"
    },
    {
      "query": 6,
      "question": "How can one measure local Jacobians, divergence, rotational nonconservative components, finite-step stability, or volume contraction of attention and feed-forward residual vector fields in pretrained transformers?"
    },
    {
      "query": 7,
      "question": "What did Mor Geva and colleagues establish in Transformer Feed-Forward Layers Build Predictions by Promoting Concepts in the Vocabulary Space, and how does neuron-level promotion or suppression explain additive MLP contributions?"
    },
    {
      "query": 8,
      "question": "What did Simon Kornblith and colleagues establish in Similarity of Neural Network Representations Revisited about invariances and limitations of CKA compared with canonical correlation analysis?"
    },
    {
      "query": 9,
      "question": "How does layer normalization constrain representation geometry and symmetries in residual transformers, and can apparent latent trajectory motion be caused by changing basis or normalization rather than changes in model function?"
    },
    {
      "query": 10,
      "question": "What does neural tangent kernel and finite-width feature-learning theory predict about changes of fixed-input representations during gradient-based training, and how are cross-token correlations induced by shared parameter updates?"
    },
    {
      "query": 11,
      "question": "What empirical or theoretical evidence supports Ornstein-Uhlenbeck, stochastic thermodynamic, or glassy descriptions of neural-network training, especially when observables are learned representations rather than optimizer parameters?"
    },
    {
      "query": 12,
      "question": "What mechanistic interpretability research identifies prediction neurons, suppression neurons, self-repair, or destructive interference in Transformer feed-forward networks and tests their effects using causal ablation?"
    }
  ],
